# Postgres (compatível com Supabase — connection string do painel do Supabase)
DATABASE_URL="postgresql://user:password@host:5432/srterno?schema=public"

# URL do site (usada no servidor para montar o link/QR de autopreenchimento)
APP_URL="http://localhost:3000"

# Chave usada para assinar a sessão de login do /admin — string aleatória longa.
# Gere uma com: openssl rand -base64 32
AUTH_SECRET="troque-por-uma-string-aleatoria-de-pelo-menos-32-caracteres"
